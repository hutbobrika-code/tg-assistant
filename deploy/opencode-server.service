[Unit]
Description=OpenCode server for the Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
User=ocbot
Group=ocbot
WorkingDirectory=/home/ocbot/workspace
EnvironmentFile=/home/ocbot/opencode-tg-bot/.env
Environment=HOME=/home/ocbot
Environment=PATH=/home/ocbot/.opencode/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ocbot/.opencode/bin/opencode serve --hostname 127.0.0.1 --port 4096
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
