[Unit]
Description=Telegram assistant bot on Gemini
After=network-online.target
Wants=network-online.target

[Service]
User=ocbot
Group=ocbot
WorkingDirectory=/home/ocbot/opencode-tg-bot
Environment=HOME=/home/ocbot
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 -u /home/ocbot/opencode-tg-bot/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
